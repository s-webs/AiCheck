# OpenAI API key (required for analysis and translation)
OPENAI_API_KEY=sk-your-api-key-here

# Dashboard login (required for Streamlit dashboard)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=your-secure-password

# Port for REST API (default 41791)
AICHECK_API_PORT=41791

# Port for Streamlit dashboard (default 41792; must differ from API port)
AICHECK_DASHBOARD_PORT=41792

# Optional: SQLite DB path (default: data/aicheck.db). For SQLite: sqlite:///./data/aicheck.db or path only
# DATABASE_URL=sqlite:///./data/aicheck.db

# Optional: require API key for REST API (X-API-Key or Authorization: Bearer <key>)
# AICHECK_API_KEY=your-secret-key

# Optional: CORS origins for API (comma-separated; use * to allow all)
# CORS_ORIGINS=https://your-laravel-domain.com,https://app.example.com
